# Copy this file to ".env" and fill in the values you need.
# Everything is optional - the app works without any of these.

# Port the server listens on
PORT=3000

# Where the SQLite database file is stored
DB_PATH=./data/ecosort.db

# Optional: Google Gemini API key for smarter photo recognition.
# Get one free at https://aistudio.google.com/apikey
# The key stays on the server and is never sent to the browser.
GEMINI_API_KEY=

# Gemini model to use for photo recognition
GEMINI_MODEL=gemini-2.5-flash
